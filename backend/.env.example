# Supabase (https://supabase.com 에서 프로젝트 생성 후 발급)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Qdrant (로컬 Docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge

# Neo4j (로컬 Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# 단일 사용자 인증 키
APP_SECRET=your-secret-key

# LLM 설정 — provider: ollama | groq | anthropic | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# 유료 전환 시 아래 키 입력 후 LLM_PROVIDER 변경
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
